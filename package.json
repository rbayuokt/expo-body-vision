{
  "name": "@rbayuokt/expo-body-vision",
  "version": "0.1.0",
  "description": "Native body tracking, pose rules, exercise counting and body interaction for React Native and Expo. Camera, inference, tracking and rendering run natively.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "node internal/module_scripts/test.js",
    "test:unit": "CI=1 jest",
    "test:changed": "node scripts/test-changed.js",
    "test:ios": "sh scripts/test-ios-core.sh",
    "test:android": "sh scripts/test-android-core.sh",
    "test:core": "npm run test:ios && npm run test:android",
    "test:e2e:smoke": "maestro test --include-tags smoke maestro/flows",
    "test:e2e": "maestro test maestro/flows",
    "test:full": "npm run typecheck && npm run lint && npm run test:unit && npm run test:core",
    "fixtures": "node scripts/generate-fixtures.js",
    "example:ios": "npm install --prefix example && npm --prefix example run ios",
    "example:android": "npm install --prefix example && npm --prefix example run android",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "docs:diagrams": "node scripts/docs-diagrams.js"
  },
  "keywords": [
    "pose estimation",
    "body tracking",
    "pose detection",
    "exercise counter",
    "rep counter",
    "fitness",
    "mediapipe",
    "react-native",
    "expo",
    "expo-modules",
    "ios",
    "android",
    "expo-body-vision",
    "ExpoBodyVision"
  ],
  "repository": "https://github.com/rbayuokt/expo-body-vision",
  "bugs": {
    "url": "https://github.com/rbayuokt/expo-body-vision/issues"
  },
  "author": "rbayuokt <rizkybayuoktavian@gmail.com> (https://github.com/rbayuokt)",
  "license": "MIT",
  "homepage": "https://github.com/rbayuokt/expo-body-vision#readme",
  "devDependencies": {
    "@shopify/react-native-skia": "^2.13.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^55.0.31",
    "expo-speech": "~55.0.18",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "~4.2.1",
    "react-native-worklets": "^0.7.4",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "@shopify/react-native-skia": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "expo-speech": "*"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./setup": {
      "types": "./build/setup/index.d.ts",
      "default": "./build/setup/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    }
  }
}
